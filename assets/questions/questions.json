    {
      "id": "text_001",
      "categoryId": "general_text",
      "text": "ما اسم البحر الذي يفصل بين آسيا وإفريقيا ؟",
      "answerText": "البحر الأحمر",
      "difficulty": 2
    },
    {
      "id": "text_002",
      "categoryId": "general_text",
      "text": "العضو المسؤول عن عن تنقية الدم في جسم الإنسان ؟",
      "answerText": "الكلية",
      "difficulty": 2
    },
    {
      "id": "text_003",
      "categoryId": "general_text",
      "text": "من هو اول من جمع القرآن ؟",
      "answerText": "أبو بكر الصديق",
      "difficulty": 2
    },
    {
      "id": "text_004",
      "categoryId": "general_text",
      "text": "اكبر دولة في العالم من حيث المساحة؟",
      "answerText": "روسيا",
      "difficulty": 1
    },
    {
      "id": "text_005",
      "categoryId": "general_text",
      "text": "أصغر دولة في العالم من حيث المساحة ؟",
      "answerText": "الفاتيكان",
      "difficulty": 4
    },
    {
      "id": "text_006",
      "categoryId": "general_text",
      "text": "ما هو أكبر محيط في العالم؟",
      "answerText": "المحيط الهادئ",
      "difficulty": 2
    },
    {
      "id": "text_007",
      "categoryId": "general_text",
      "text": "اول نبي بعث بعد آدم؟",
      "answerText": "نوح",
      "difficulty": 2
    },
    {
      "id": "text_008",
      "categoryId": "general_text",
      "text": "اكبر دولة في العالم من حيث عدد السكان ؟",
      "answerText": "الهند",
      "difficulty": 2
    },
    {
      "id": "text_009",
      "categoryId": "general_text",
      "text": "ما هي أقدم عاصمة مأهوله في العالم؟",
      "answerText": "دمشق",
      "difficulty": 3
    },
    {
      "id": "text_010",
      "categoryId": "general_text",
      "text": "من هو اول خليفة أموي؟",
      "answerText": "معاوية بن أبي سفيان",
      "difficulty": 2
    },
    {
      "id": "text_011",
      "categoryId": "general_text",
      "text": "ما اسم العملية التي يتحول بها السائل الى غاز؟",
      "answerText": "عملية التبخر",
      "difficulty": 2
    },
    {
      "id": "text_013",
      "categoryId": "general_text",
      "text": "ماهي القارة التي تحتوي على اكبر عدد من الدول ؟",
      "answerText": "إفريقيا",
      "difficulty": 2
    },
    {
      "id": "text_014",
      "categoryId": "general_text",
      "text": "ما اسم المضيق الذي يفصل بين إسبانيا والمغرب؟",
      "answerText": "مضيق جبل طارق",
      "difficulty": 2
    },
    {
      "id": "text_015",
      "categoryId": "general_text",
      "text": "ما اسم الغاز الذي يستخدم في إطفاء النار ؟",
      "answerText": "ثاني أكسيد الكربون",
      "difficulty": 2
    },
    {
      "id": "text_016",
      "categoryId": "general_text",
      "text": "ما هو الكوكب الذي يمتلك اكبر عدد من الاقمار ؟",
      "answerText": "زحل",
      "difficulty": 2
    },
    {
      "id": "text_017",
      "categoryId": "general_text",
      "text": "من هو مؤسس علم الاجتماع ؟",
      "answerText": "ابن خلدون",
      "difficulty": 3
    },
    {
      "id": "text_018",
      "categoryId": "general_text",
      "text": "ما هو أطول نهر في العالم ؟",
      "answerText": "نهر النيل",
      "difficulty": 1
    },
    {
      "id": "text_019",
      "categoryId": "general_text",
      "text": "ما اسم صغير الدب؟",
      "answerText": "ديسم",
      "difficulty": 3
    },
    {
      "id": "text_020",
      "categoryId": "general_text",
      "text": "ما هي عمله اليابان ؟",
      "answerText": "الين الياباني",
      "difficulty": 2
    },
    {
      "id": "text_021",
      "categoryId": "general_text",
      "text": "ما اسم صغير الفيل؟",
      "answerText": "دغفل",
      "difficulty": 5
    },
    {
      "id": "text_022",
      "categoryId": "general_text",
      "text": "كم عدد العظام في جسم الإنسان ؟",
      "answerText": "206",
      "difficulty": 4
    },
    {
      "id": "islamic_001",
      "categoryId": "islamic",
      "text": "من كان رأس الفتنة في عهد عثمان بن عفان ؟",
      "answerText": "عبد الله بن سبأ",
      "difficulty": 3
    },
    {
      "id": "islamic_002",
      "categoryId": "islamic",
      "text": "من هو الشخص الذي رآه رسول الله في السماء الأولى في رحلة الإسراء والمعراج ؟",
      "answerText": "آدم عليه السلام",
      "difficulty": 4
    },
    {
      "id": "islamic_003",
      "categoryId": "islamic",
      "text": "أي نبي آمن به جميع قومه ولم يكذبه أحد ؟",
      "answerText": "يونس عليه السلام",
      "difficulty": 3
    },
    {
      "id": "islamic_004",
      "categoryId": "islamic",
      "text": "ما هو الحرف الوحيد الذي لم يُذكر في أي اسم من أسماء سور القرآن ؟",
      "answerText": "حرف الظاء (ظ)",
      "difficulty": 4
    },
    {
      "id": "islamic_005",
      "categoryId": "islamic",
      "text": "ما هي السورة التي تسمى “قلب القرآن” ؟",
      "answerText": "سورة يس",
      "difficulty": 2
    },
    {
      "id": "islamic_006",
      "categoryId": "islamic",
      "text": "من هو النبي الذي كان قومه يعبدون الأيكة ؟",
      "answerText": "شعيب عليه السلام",
      "difficulty": 4
    },
    {
      "id": "islamic_007",
      "categoryId": "islamic",
      "text": "كم عدد كلمات أعظم آية في القرآن (آية الكرسي) ؟",
      "answerText": "50 كلمة",
      "difficulty": 3
    },
    {
      "id": "islamic_008",
      "categoryId": "islamic",
      "text": "ما هي السورة التي لا تحتوي على حرف الميم ؟",
      "answerText": "سورة الكوثر",
      "difficulty": 3
    },
    {
      "id": "islamic_009",
      "categoryId": "islamic",
      "text": "ما هي السورة التي لا تحتوي على حرف الراء ؟",
      "answerText": "سورة الإخلاص",
      "difficulty": 3
    },
    {
      "id": "islamic_010",
      "categoryId": "islamic",
      "text": "كم مرة ذكرت بسم الله الرحمن الرحيم في المصحف ؟",
      "answerText": "114 مرة",
      "difficulty": 3
